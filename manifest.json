{
  "manifest_version": 3,
  "name": "TestPad Pocket",
  "version": "2.2.0",
  "description": "Краткое решение текущей задачи OnlineTestPad.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://api.302ai.cn/*",
    "https://api.302.ai/*",
    "https://raw.githubusercontent.com/ayeepat/testpad-pocket/*",
    "https://onlinetestpad.com/*",
    "https://*.onlinetestpad.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://onlinetestpad.com/*", "https://*.onlinetestpad.com/*"],
      "js": ["extension/question.js", "extension/panel.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "extension/worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "TestPad Pocket",
    "default_popup": "extension/popup.html"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {"default": "Ctrl+Shift+8", "mac": "MacCtrl+Shift+8"},
      "description": "Показать или скрыть панель"
    },
    "solve": {
      "suggested_key": {"default": "Ctrl+Shift+9", "mac": "MacCtrl+Shift+9"},
      "description": "Решить текущее задание (работает и когда панель скрыта)"
    }
  }
}
