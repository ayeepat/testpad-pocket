{
  "manifest_version": 3,
  "name": "TestPad Pocket",
  "version": "1.0.1",
  "description": "Краткое решение текущей задачи OnlineTestPad.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://onlinetestpad.com/*",
        "https://*.onlinetestpad.com/*"
      ],
      "js": [
        "extension/question.js",
        "extension/panel.js"
      ]
    }
  ],
  "background": {
    "service_worker": "extension/worker.js"
  },
  "action": {
    "default_title": "TestPad Pocket · настройки"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "MacCtrl+Shift+8"
      },
      "description": "Показать или скрыть решение"
    }
  }
}
